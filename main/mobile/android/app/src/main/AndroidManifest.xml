<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- 手机原生收集入口：浏览器/相册/文件管理器可把文字、图片和文件分享进本地收集箱。 -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>

            <!-- 长按图标快捷方式：打开同步设置（保留旧 action 以兼容原地升级） -->
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />

            <!-- 邀请链接直达：别人把 engram://join?hub=…&token=… 发到手机，点一下直接打开
                 Engram 并填好中枢地址与绑定令牌（网页侧的接收函数见 web/src/lib/joinLink.ts，
                 投递见 MainActivity.handleJoinLink）。 -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="engram" android:host="join" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 多端同步「扫码绑定」：应用内摄像头预览扫码走 WebView 的 getUserMedia，
         Capacitor 的 WebChromeClient 会在网页请求摄像头时向系统申请这条运行时权限
         （见 mobile/node_modules/@capacitor/android 的 BridgeWebChromeClient.onPermissionRequest）。
         uses-feature required="false"：扫码只是可选功能，别让没有摄像头的设备装不上。 -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <!-- 登录页的「指纹/人脸解锁」走系统 BiometricPrompt（见 BiometricUnlock.java）：
         API 28+ 要 USE_BIOMETRIC，API 23-27 的旧指纹接口要 USE_FINGERPRINT（判能力用，不采集）。
         两个都是普通权限，安装即授予，不会弹权限对话框。 -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <uses-permission android:name="android.permission.USE_FINGERPRINT" />
    <!-- 应用内在线更新（见 AppUpdater.kt）：侧载 APK 只能靠系统安装器安装，需要这条普通权限声明；
         真正的授权开关在系统「安装未知应用」里，未授权时界面会引导去开启。
         通知权限（Android 13+）用于「新版本已下载」的提醒，属运行时权限，用户点开关时才申请。 -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
</manifest>
