# CI 环境构建 Windows 安装包（wine 容器内交叉打包）
# Windows runner 上 Z 盘不支持 docker bind mount，故源码 COPY 进镜像构建、
# 产物用 docker create + docker cp 拷出（与 XINJE 项目的做法一致）。
# 构建上下文为 main/ 目录：
#   docker build -f desktop/Dockerfile.ci -t exampleproject-desktop-builder .
# 产物在镜像内 /work/desktop/dist/：
#   CID=$(docker create exampleproject-desktop-builder)
#   docker cp "$CID:/work/desktop/dist/." <输出目录>
#   docker rm "$CID"
FROM electronuserland/builder:wine

ENV ELECTRON_MIRROR=https://npmmirror.com/mirrors/electron/ \
    ELECTRON_BUILDER_BINARIES_MIRROR=https://npmmirror.com/mirrors/electron-builder-binaries/

WORKDIR /work
COPY . .
RUN bash scripts/build-desktop-ci.sh
