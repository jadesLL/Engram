{
  "name": "@engram/desktop",
  "version": "1.1.30",
  "private": true,
  "description": "Engram Windows 桌面端（本地内嵌 / 远端连接双模式）",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "rebuild": "npx -y @electron/rebuild -f -m ./server",
    "dist": "electron-builder --win nsis",
    "dist:portable": "electron-builder --win portable"
  },
  "devDependencies": {
    "electron": "^35.1.5",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.llmwiki.app",
    "productName": "Engram",
    "asar": true,
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "server/dist/**",
      "server/node_modules/**",
      "server/package.json",
      "web/dist/**"
    ],
    "asarUnpack": [
      "server/node_modules/**/better-sqlite3/**",
      "server/node_modules/**/sqlite-vec*/**",
      "server/node_modules/@napi-rs/canvas*/**"
    ],
    "win": {
      "target": ["nsis", "portable"],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "Engram",
      "include": "build/installer.nsh"
    }
  }
}
