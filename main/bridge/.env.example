# ExampleProject MCP 端点与 token（在 ExampleProject Settings 里生成 MCP token）
WIKILLM_MCP_URL=http://example-wiki:8080/mcp
WIKILLM_MCP_TOKEN=lwiki_xxxxxxxxxxxxxxxxxxxxxxxx

# 飞书自建应用凭证（飞书开放平台 → 应用详情）
FEISHU_APP_ID=
FEISHU_APP_SECRET=
# 事件订阅加密密钥与校验 token（在「事件与回调」页配置；不加密则留空）
FEISHU_ENCRYPT_KEY=
FEISHU_VERIFY_TOKEN=

# 出站通知转发的目标 open_id（阶段三；先留空）
NOTIFY_OPEN_ID=

# 会话记忆轮数与 think 超时
SESSION_MAX_ROUNDS=6
THINK_TIMEOUT_MS=120000
