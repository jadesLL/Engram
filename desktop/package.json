{
  "name": "@example-wiki/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "LLM Wiki Windows 桌面端",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis",
    "dist:portable": "electron-builder --win portable"
  },
  "devDependencies": {
    "electron": "^35.1.5",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.llmwiki.app",
    "productName": "LLM Wiki",
    "files": ["main.js", "preload.js", "index.html"],
    "win": {
      "target": ["nsis", "portable"],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "LLM Wiki"
    }
  }
}
